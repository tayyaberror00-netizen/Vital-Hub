# Copy this file to .env and fill in real values.
# Never commit the real .env file.

# Django
SECRET_KEY=replace-with-a-long-random-string
JWT_SECRET=replace-with-a-different-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS (comma-separated, no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# AI — OpenRouter (free tier, provider-agnostic gateway). Get a key at
# https://openrouter.ai/keys — no credit card required.
OPENROUTER_API_KEY=your-openrouter-api-key-here
# Optional — override which free model is used. Only change this if the
# default gets delisted/rate-limited; check https://openrouter.ai/models?max_price=0
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Optional — Gemini is currently unused (hit an unresolved Google-side auth
# bug in mid-2026 affecting new "AQ."-prefix keys); kept here in case Google
# fixes it and you want to switch back.
GEMINI_API_KEY=

# Optional — only needed if you re-enable any Anthropic-based features
ANTHROPIC_API_KEY=

# Google OAuth (Sign in with Google). Create a Web application OAuth Client
# at https://console.cloud.google.com/apis/credentials — add both
# http://localhost:8000 and http://127.0.0.1:8000 as authorized JavaScript
# origins. Leave blank to hide the Google button and keep email/password only.
GOOGLE_OAUTH_CLIENT_ID=

# Gmail SMTP (Contact Us form). Requires 2-Step Verification enabled on the
# Gmail account, then generate an "App Password" at
# https://myaccount.google.com/apppasswords — use THAT here, never your real
# Gmail password. Leave blank to print emails to the console instead
# (useful for local dev without setting this up yet).
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
CONTACT_RECIPIENT_EMAIL=vitalhub52@gmail.com
